---
/**
 * @file src/layouts/Layout.astro
 * @description 2026 旗舰级 Astro 布局基座 (Phase 5 终极合体版)
 */
import BackgroundFx from '../components/BackgroundFx.vue';
import Toast from '../components/Toast.vue';
import Lightbox from '../components/Lightbox.vue';
import BackToTop from '../components/BackToTop.vue';
import Modals from '../components/Modals.vue';
import { publicEnv } from '../utils/env.js';

const {
    title = "拾光集 - 岁月留影",
    description = "一个承载照片、回音与岁月纹理的私人记忆角落。",
    ogImage = 'favicon.ico',
} = Astro.props;
const normalizedSiteUrl = publicEnv.siteUrl.replace(/\/$/, '');
const buildAbsoluteUrl = (path) => {
    const normalizedPath = path.startsWith('/') ? path : `/${path}`;
    if (!normalizedSiteUrl) return `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
    return `${normalizedSiteUrl}${normalizedPath}`;
};
const faviconUrl = `${import.meta.env.BASE_URL}favicon.ico`;
const socialImageUrl = buildAbsoluteUrl(ogImage);
const canonicalUrl = normalizedSiteUrl ? `${normalizedSiteUrl}${Astro.url.pathname}` : null;
const shouldRegisterServiceWorker = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8CA192" />
    <link rel="icon" type="image/x-icon" href={faviconUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script is:inline define:vars={{ shouldRegisterServiceWorker }}>
        if (shouldRegisterServiceWorker && 'serviceWorker' in navigator) {
            const swCode = `
                const CACHE_NAME = 'shiguang-v2026-final';
                self.addEventListener('fetch', e => {
                    // 🛡️ 精准路由门神：绝对放行非 GET 请求，以及所有数据库和图床请求
                    if (
                        e.request.method !== 'GET' || 
                        e.request.url.includes('supabase.co') || 
                        e.request.url.includes('myqcloud.com')
                    ) {
                        return; 
                    }
                    
                    e.respondWith(
                        caches.match(e.request).then(res => {
                            return res || fetch(e.request).then(fetchRes => {
                                return caches.open(CACHE_NAME).then(cache => { 
                                    cache.put(e.request, fetchRes.clone()); 
                                    return fetchRes; 
                                });
                            });
                        }).catch(() => {})
                    );
                });
            `;
            const blob = new Blob([swCode], { type: 'application/javascript' });
            navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
        }
    </script>

    <style is:global>
        :root {
            /* === Color Palette === */
            --bg-base: #F7F9F8;
            --bg-subtle: #E8EDE9;
            --text-dark: #2C3631;
            --text-muted: #8B9992;
            --accent-color: #8CA192;
            --accent-hover: #7A9080;
            --border-light: #E8EDE9;

            /* === Glass System (3-tier depth) === */
            --glass-deep: rgba(255, 255, 255, 0.06);
            --glass-float: rgba(255, 255, 255, 0.12);
            --glass-surface: rgba(255, 255, 255, 0.22);
            --glass-bg: rgba(255, 255, 255, 0.72);
            --glass-console: rgba(255, 255, 255, 0.58);
            --glass-border: rgba(255, 255, 255, 0.35);
            --glass-border-bright: rgba(255, 255, 255, 0.55);
            --glass-rim: inset 0 1px 0 rgba(255, 255, 255, 0.5);

            /* === Shadows === */
            --shadow-soft: 0 12px 35px rgba(0, 0, 0, 0.04);
            --shadow-float: 0 25px 50px rgba(140, 161, 146, 0.12);
            --shadow-glow: 0 8px 32px rgba(140, 161, 146, 0.18);

            /* === Animation Tokens === */
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --ease-out-back: cubic-bezier(0.34, 1.56, 0.64, 1);
            --cubic-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
            --cubic-smooth: cubic-bezier(0.25, 1, 0.5, 1);
            --duration-fast: 150ms;
            --duration-normal: 300ms;
            --duration-slow: 500ms;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Noto Serif SC', serif;
            background-color: var(--bg-base);
            background-image: linear-gradient(135deg, var(--bg-base) 0%, var(--bg-subtle) 100%);
            background-attachment: fixed;
            color: var(--text-dark);
            min-height: 100vh;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            transition: background-color var(--duration-slow) ease, color var(--duration-slow) ease;
        }

        /* UI elements use system sans-serif — buttons, inputs, labels, badges */
        button, input, select, textarea,
        .btn-shiguang, .controls-row, .search-box,
        .comment-input-box, .time-badge, .subtitle,
        .card-author, .comment-meta, .field-meta,
        .helper-text, .modal-desc {
            font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
        }

        /* === Reduced Motion === */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body>
    <BackgroundFx client:only="vue" />

    <div style="position: relative; z-index: 10;">
        <slot />
    </div>

    <Toast client:load />
    <Lightbox client:load />
    <BackToTop client:load />
    <Modals client:load />
    </body>
</html>
